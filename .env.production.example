# Production settings for docker-compose.prod.yml. Copy to .env.production (never commit it).
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

POSTGRES_ADMIN_USER=acra_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_DB=acra
APP_DB_USER=acra_app
APP_DB_PASSWORD=
REDIS_PASSWORD=

# Public https address of the platform (TLS terminated in front of the dashboard container).
DASHBOARD_PUBLIC_URL=https://review.example.com
WEBHOOK_PUBLIC_BASE_URL=https://review.example.com
# The dashboard port binds to 127.0.0.1; run your TLS proxy on this host. nginx accepts X-Forwarded-For
# only from TRUSTED_PROXY_CIDR (Docker bridge range by default) and the API trusts exactly that nginx.
DASHBOARD_BIND=127.0.0.1
TRUSTED_PROXY_CIDR=172.16.0.0/12

# Envelope-encryption key for stored provider tokens (base64, 32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_MASTER_KEY=
GITLAB_ALLOWED_HOSTS=gitlab.com

# GitHub App (optional). Inline key with "\n" escapes.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Transactional mail (worker only, ADR-040). Leave MAIL_SMTP_URL empty to disable mail.
# Use implicit TLS (smtps://...:465) or STARTTLS (smtp://...:587); MAIL_REQUIRE_TLS must stay true.
# Configure SPF, DKIM and DMARC for the sender domain at your DNS provider (see DEPLOYMENT.md).
# Set MAIL_SMTP_URL and MAIL_FROM together (the worker refuses one without the other), e.g.
#   MAIL_SMTP_URL=smtps://apikey:<secret>@smtp.provider.example:465
#   MAIL_FROM=AI Code Review <noreply@review.example.com>
MAIL_SMTP_URL=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_REQUIRE_TLS=true

# AI reviewers (worker only).
ANTHROPIC_API_KEY=
ANTHROPIC_REVIEW_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=
AI_REVIEW_TIMEOUT_MS=600000

# Prometheus scrape token for /api/metrics and the worker's /metrics (at least 20 characters).
METRICS_TOKEN=
LOG_LEVEL=info

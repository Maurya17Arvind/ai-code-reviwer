{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2023"],
    "importHelpers": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "paths": {
      "@acra/agent-core": ["./libs/agent-core/src/index.ts"],
      "@acra/ai-providers-claude": ["./libs/ai-providers/claude/src/index.ts"],
      "@acra/ai-providers-core": ["./libs/ai-providers/core/src/index.ts"],
      "@acra/ai-providers-factory": ["./libs/ai-providers/factory/src/index.ts"],
      "@acra/ai-providers-ollama": ["./libs/ai-providers/ollama/src/index.ts"],
      "@acra/ai-providers-openai": ["./libs/ai-providers/openai/src/index.ts"],
      "@acra/approvals": ["./libs/approvals/src/index.ts"],
      "@acra/configuration": ["./libs/configuration/src/index.ts"],
      "@acra/database": ["./libs/database/src/index.ts"],
      "@acra/fix-engine": ["./libs/fix-engine/src/index.ts"],
      "@acra/git-providers-core": ["./libs/git-providers/core/src/index.ts"],
      "@acra/git-providers-github": ["./libs/git-providers/github/src/index.ts"],
      "@acra/git-providers-gitlab": ["./libs/git-providers/gitlab/src/index.ts"],
      "@acra/git-providers-local": ["./libs/git-providers/local/src/index.ts"],
      "@acra/publishing": ["./libs/publishing/src/index.ts"],
      "@acra/queue": ["./libs/queue/src/index.ts"],
      "@acra/repository-context": ["./libs/repository-context/src/index.ts"],
      "@acra/review-engine": ["./libs/review-engine/src/index.ts"],
      "@acra/sandbox": ["./libs/sandbox/src/index.ts"],
      "@acra/security": ["./libs/security/src/index.ts"],
      "@acra/shared-contracts": ["./libs/shared/contracts/src/index.ts"],
      "@acra/shared-types": ["./libs/shared/types/src/index.ts"],
      "@acra/testing": ["./tools/testing/index.ts"]
    },
    "exactOptionalPropertyTypes": true
  },
  "exclude": ["node_modules", "tmp", "dist"]
}

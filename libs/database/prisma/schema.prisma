// AI Code Review Agent — PostgreSQL schema.
//
// Phase 1 scope: tenancy foundation only (organizations, users, memberships, repositories, audit logs).
// The full target model is documented in docs/DATABASE_DESIGN.md; remaining tables are added
// in the phase that first uses them.
//
// Conventions:
//   - UUIDv7 primary keys (time-ordered, index friendly).
//   - snake_case table/column names via @@map/@map.
//   - timestamptz(3) for all timestamps.
//   - Every tenant-owned table carries organization_id (tenant isolation, ADR-010).
//   - Soft deletion (deleted_at) for user-facing aggregates; audit_logs is append-only.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("organization_role")
}

enum GitProviderKind {
  GITHUB
  GITLAB
  LOCAL

  @@map("git_provider_kind")
}

enum AuditActorType {
  USER
  SYSTEM
  WEBHOOK

  @@map("audit_actor_type")
}

model Organization {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(200)
  /// URL-safe unique identifier, lower-case.
  slug      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  members      OrganizationMember[]
  repositories Repository[]
  auditLogs    AuditLog[]
  connections  ProviderConnection[]
  sessions     ReviewSession[]
  findings     ReviewFinding[]
  fixes        ProposedFix[]
  approvals    ApprovalRequest[]
  settings     OrganizationSettings?

  @@map("organizations")
}

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Stored normalised to lower case by the application layer.
  email             String    @unique @db.VarChar(320)
  displayName       String    @map("display_name") @db.VarChar(200)
  /// scrypt hash in PHC-like format (see apps/api auth/password.ts). Null until the user sets a password.
  passwordHash      String?   @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  /// Consecutive failed sign-ins; reset on success. Drives the temporary lockout.
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  memberships       OrganizationMember[]
  auditLogs         AuditLog[]
  requestedApproval ApprovalRequest[]    @relation("ApprovalRequestedBy")
  decidedApproval   ApprovalRequest[]    @relation("ApprovalDecidedBy")
  sessions          UserSession[]
  setupTokens       UserSetupToken[]     @relation("SetupTokenUser")
  issuedSetupTokens UserSetupToken[]     @relation("SetupTokenIssuer")

  @@map("users")
}

model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Repository {
  id                String          @id @default(uuid(7)) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  provider          GitProviderKind
  /// Provider-side identifier (GitLab project id, GitHub repository id). Null for LOCAL.
  externalId        String?         @map("external_id") @db.VarChar(100)
  /// e.g. "group/subgroup/project" or "owner/repo".
  fullName          String          @map("full_name") @db.VarChar(500)
  defaultBranch     String          @default("main") @map("default_branch") @db.VarChar(255)
  webUrl            String?         @map("web_url") @db.VarChar(2048)
  isActive          Boolean         @default(true) @map("is_active")
  /// Provider connection used to access this repository (null for LOCAL).
  connectionId      String?         @map("connection_id") @db.Uuid
  /// SHA-256 of the per-repository webhook token; the token itself is never stored.
  webhookSecretHash String?         @map("webhook_secret_hash") @db.VarChar(64)
  webhookId         String?         @map("webhook_id") @db.VarChar(100)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connection   ProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  sessions     ReviewSession[]
  findings     ReviewFinding[]

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, isActive])
  @@map("repositories")
}

/// Append-only. UPDATE and DELETE are rejected by a database trigger (see migration).
model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  /// Null for platform-level events that are not tied to a tenant.
  organizationId String?        @map("organization_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  /// Dotted verb, e.g. "repository.connected", "approval.granted".
  action         String         @db.VarChar(100)
  targetType     String         @map("target_type") @db.VarChar(100)
  targetId       String?        @map("target_id") @db.VarChar(100)
  /// Structured context. Must never contain secrets (enforced by the audit service).
  metadata       Json           @default("{}")
  requestId      String?        @map("request_id") @db.VarChar(100)
  ipAddress      String?        @map("ip_address") @db.Inet
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 4: provider connections, review sessions, findings, comments, webhooks
// ---------------------------------------------------------------------------

enum ReviewSessionStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  SUPERSEDED
  SKIPPED

  @@map("review_session_status")
}

enum FindingStatus {
  NEW
  VALIDATED
  PUBLISHED
  RESOLVED
  DISMISSED
  FALSE_POSITIVE

  @@map("finding_status")
}

enum CommentKind {
  INLINE
  SUMMARY

  @@map("comment_kind")
}

enum WebhookDeliveryStatus {
  ACCEPTED
  IGNORED
  REJECTED

  @@map("webhook_delivery_status")
}

/// Credentials for a GitLab/GitHub instance. The token is envelope-encrypted (ADR-011) and bound
/// to this row's id as associated data; it never leaves the backend.
model ProviderConnection {
  id             String          @id @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  provider       GitProviderKind
  name           String          @db.VarChar(200)
  /// Validated against the SSRF policy when created and before use.
  baseUrl        String          @map("base_url") @db.VarChar(2048)
  /// GitLab: envelope-encrypted token. GitHub App connections hold no per-connection secret.
  encryptedToken Json?           @map("encrypted_token")
  tokenKeyId     String?         @map("token_key_id") @db.VarChar(32)
  /// GitHub App installation id (one installation belongs to exactly one organization).
  installationId String?         @map("installation_id") @db.VarChar(50)
  /// GitHub account (org/user) the app is installed on.
  accountLogin   String?         @map("account_login") @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  repositories Repository[]

  @@unique([organizationId, provider, name])
  @@unique([provider, installationId])
  @@map("provider_connections")
}

model ReviewSession {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  repositoryId   String              @map("repository_id") @db.Uuid
  /// MR iid / PR number.
  requestId      Int?                @map("request_id")
  baseSha        String?             @map("base_sha") @db.VarChar(64)
  headSha        String              @map("head_sha") @db.VarChar(64)
  contextHash    String?             @map("context_hash") @db.VarChar(64)
  promptHash     String?             @map("prompt_hash") @db.VarChar(64)
  status         ReviewSessionStatus @default(QUEUED)
  /// "gitlab:<repositoryId>:<iid>:<headSha>" — one session per head commit.
  idempotencyKey String              @unique @map("idempotency_key") @db.VarChar(200)
  report         Json?
  errorCode      String?             @map("error_code") @db.VarChar(100)
  errorMessage   String?             @map("error_message") @db.VarChar(1000)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt      DateTime?           @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?           @map("finished_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  repository   Repository        @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  executions   ModelExecution[]
  comments     ReviewComment[]
  fixes        ProposedFix[]
  approvals    ApprovalRequest[]

  @@index([repositoryId, requestId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("review_sessions")
}

model ModelExecution {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  reviewSessionId String   @map("review_session_id") @db.Uuid
  provider        String   @db.VarChar(20)
  model           String   @db.VarChar(100)
  servedByModel   String?  @map("served_by_model") @db.VarChar(100)
  status          String   @db.VarChar(20)
  errorKind       String?  @map("error_kind") @db.VarChar(50)
  inputTokens     Int      @default(0) @map("input_tokens")
  outputTokens    Int      @default(0) @map("output_tokens")
  cacheReadTokens Int      @default(0) @map("cache_read_tokens")
  /// Estimated cost in millionths of a USD (null when unknown).
  costMicros      BigInt?  @map("cost_micros")
  latencyMs       Int      @map("latency_ms")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session ReviewSession @relation(fields: [reviewSessionId], references: [id], onDelete: Restrict)

  @@index([reviewSessionId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("model_executions")
}

/// One row per (repository, MR, fingerprint): the lifecycle of an issue across commits.
model ReviewFinding {
  id             String        @id @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  repositoryId   String        @map("repository_id") @db.Uuid
  requestId      Int           @map("request_id")
  fingerprint    String        @db.VarChar(64)
  lastSessionId  String        @map("last_session_id") @db.Uuid
  filePath       String        @map("file_path") @db.VarChar(1000)
  lineNumber     Int?          @map("line_number")
  endLineNumber  Int?          @map("end_line_number")
  severity       String        @db.VarChar(10)
  category       String        @db.VarChar(40)
  title          String        @db.VarChar(300)
  description    String
  evidence       String
  suggestion     String?
  confidence     Float
  sources        String[]
  placement      String        @db.VarChar(10)
  status         FindingStatus
  firstSeenSha   String        @map("first_seen_sha") @db.VarChar(64)
  lastSeenSha    String        @map("last_seen_sha") @db.VarChar(64)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  repository   Repository      @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  comments     ReviewComment[]
  fixes        ProposedFix[]

  @@unique([repositoryId, requestId, fingerprint])
  @@index([organizationId, status])
  @@map("review_findings")
}

model ReviewComment {
  id                   String      @id @default(uuid(7)) @db.Uuid
  organizationId       String      @map("organization_id") @db.Uuid
  reviewSessionId      String      @map("review_session_id") @db.Uuid
  findingId            String?     @map("finding_id") @db.Uuid
  kind                 CommentKind
  providerDiscussionId String?     @map("provider_discussion_id") @db.VarChar(100)
  providerNoteId       String      @map("provider_note_id") @db.VarChar(100)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  session ReviewSession  @relation(fields: [reviewSessionId], references: [id], onDelete: Restrict)
  finding ReviewFinding? @relation(fields: [findingId], references: [id], onDelete: Restrict)

  @@index([reviewSessionId])
  @@index([findingId])
  @@map("review_comments")
}

/// Idempotency record for incoming webhooks (replay protection).
model WebhookDelivery {
  id           String                @id @default(uuid(7)) @db.Uuid
  provider     GitProviderKind
  deliveryId   String                @map("delivery_id") @db.VarChar(200)
  repositoryId String?               @map("repository_id") @db.Uuid
  event        String                @db.VarChar(100)
  status       WebhookDeliveryStatus
  reason       String?               @db.VarChar(200)
  receivedAt   DateTime              @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([provider, deliveryId])
  @@index([repositoryId, receivedAt(sort: Desc)])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Phase 6: fix proposals and approval requests (Modules G and H)
// ---------------------------------------------------------------------------

enum ProposedFixStatus {
  /// Generated and validated; nothing written anywhere.
  PROPOSED
  /// Approved fix committed to its own branch on the provider.
  APPLIED
  /// MR/PR opened for the fix branch (never merged by the platform).
  OPENED
  /// A newer commit was reviewed; the fix no longer applies to the reviewed code.
  SUPERSEDED
  REJECTED

  @@map("proposed_fix_status")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  INVALIDATED
  EXECUTING
  EXECUTED
  FAILED

  @@map("approval_status")
}

/// No MERGE value exists: merging is not implemented (Module H).
enum ApprovalOperationKind {
  APPLY_FIX
  STAGE_CHANGES
  COMMIT_CHANGES
  PUSH_BRANCH
  COMMIT_AND_PUSH_FIX
  CREATE_MERGE_REQUEST
  CREATE_PULL_REQUEST

  @@map("approval_operation_kind")
}

/// A validated AI fix for one finding at one reviewed commit. The patch is computed by the platform.
model ProposedFix {
  id               String            @id @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  repositoryId     String            @map("repository_id") @db.Uuid
  reviewSessionId  String            @map("review_session_id") @db.Uuid
  findingId        String            @map("finding_id") @db.Uuid
  requestId        Int               @map("request_id")
  fingerprint      String            @db.VarChar(64)
  filePath         String            @map("file_path") @db.VarChar(1000)
  /// Reviewed head commit the fix is computed against.
  baseSha          String            @map("base_sha") @db.VarChar(64)
  /// MR/PR source branch at proposal time: the fix MR/PR targets it.
  targetBranch     String            @map("target_branch") @db.VarChar(255)
  /// Model-written explanation (untrusted text).
  explanation      String
  /// Line changes the patch and result are recomputed from.
  changes          Json
  patch            String
  patchSha256      String            @map("patch_sha256") @db.Char(64)
  originalSha256   String            @map("original_sha256") @db.Char(64)
  resultSha256     String            @map("result_sha256") @db.Char(64)
  additions        Int
  deletions        Int
  provider         String            @db.VarChar(20)
  model            String            @db.VarChar(100)
  costMicros       BigInt?           @map("cost_micros")
  status           ProposedFixStatus @default(PROPOSED)
  branch           String            @db.VarChar(255)
  commitSha        String?           @map("commit_sha") @db.VarChar(64)
  reviewRequestUrl String?           @map("review_request_url") @db.VarChar(2048)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session      ReviewSession     @relation(fields: [reviewSessionId], references: [id], onDelete: Restrict)
  finding      ReviewFinding     @relation(fields: [findingId], references: [id], onDelete: Restrict)
  approvals    ApprovalRequest[]

  @@index([repositoryId, requestId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("proposed_fixes")
}

/// A human approval for exactly one operation, bound by `binding_hash` (see @acra/approvals).
model ApprovalRequest {
  id              String                @id @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  repositoryId    String                @map("repository_id") @db.Uuid
  reviewSessionId String                @map("review_session_id") @db.Uuid
  proposedFixId   String?               @map("proposed_fix_id") @db.Uuid
  requestId       Int                   @map("request_id")
  headSha         String                @map("head_sha") @db.VarChar(64)
  operationKind   ApprovalOperationKind @map("operation_kind")
  /// The exact operation (branch, message, title, target, commit) that was shown and approved.
  operation       Json
  patchSha256     String?               @map("patch_sha256") @db.Char(64)
  bindingHash     String                @map("binding_hash") @db.Char(64)
  status          ApprovalStatus        @default(PENDING)
  requestedById   String                @map("requested_by_id") @db.Uuid
  /// Actor snapshot included in the binding hash.
  requestedBy     Json                  @map("requested_by")
  decidedById     String?               @map("decided_by_id") @db.Uuid
  decidedBy       Json?                 @map("decided_by")
  decidedAt       DateTime?             @map("decided_at") @db.Timestamptz(3)
  reason          String?               @db.VarChar(500)
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz(3)
  executedAt      DateTime?             @map("executed_at") @db.Timestamptz(3)
  result          Json?
  createdAt       DateTime              @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session      ReviewSession @relation(fields: [reviewSessionId], references: [id], onDelete: Restrict)
  fix          ProposedFix?  @relation(fields: [proposedFixId], references: [id], onDelete: Restrict)
  requester    User          @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decider      User?         @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt])
  @@index([repositoryId, requestId, status])
  @@index([proposedFixId])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------
// Phase 7: dashboard authentication and organization policy
// ---------------------------------------------------------------------------

/// A signed-in browser session. Only the SHA-256 of the cookie token is stored (ADR-035).
model UserSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute expiry; idle expiry is enforced from last_seen_at by the application.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.Inet
  userAgent  String?   @map("user_agent") @db.VarChar(300)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

enum SetupTokenPurpose {
  INVITE
  RESET

  @@map("setup_token_purpose")
}

/// Single-use link that lets a user set a password (invitation or admin-issued reset).
model UserSetupToken {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  tokenHash   String            @unique @map("token_hash") @db.Char(64)
  purpose     SetupTokenPurpose
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?         @map("used_at") @db.Timestamptz(3)

  user      User  @relation("SetupTokenUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User? @relation("SetupTokenIssuer", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_setup_tokens")
}

/// Organization-wide review policy. It can only restrict what a repository's ai-review.yaml asks
/// for (providers, fixes, thresholds); it can never relax approvals (ADR-036).
model OrganizationSettings {
  organizationId         String   @id @map("organization_id") @db.Uuid
  reviewsEnabled         Boolean  @default(true) @map("reviews_enabled")
  allowClaude            Boolean  @default(true) @map("allow_claude")
  allowOpenai            Boolean  @default(true) @map("allow_openai")
  allowOllama            Boolean  @default(true) @map("allow_ollama")
  allowFixProposals      Boolean  @default(true) @map("allow_fix_proposals")
  /// Floors: the effective value is the stricter of this and the repository's configuration.
  minimumSeverityFloor   String?  @map("minimum_severity_floor") @db.VarChar(10)
  minimumConfidenceFloor Float?   @map("minimum_confidence_floor")
  updatedById            String?  @map("updated_by_id") @db.Uuid
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_settings")
}

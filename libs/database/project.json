{
  "name": "database",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/database/src",
  "projectType": "library",
  "tags": ["scope:server", "type:adapter"],
  "// targets": "to see all targets run: nx show project database --web",
  "targets": {
    "prisma-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma generate --config libs/database/prisma.config.ts",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": ["{projectRoot}/prisma/schema.prisma", "{projectRoot}/prisma.config.ts"],
      "outputs": ["{projectRoot}/src/generated/prisma"]
    },
    "migrate-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate dev --config libs/database/prisma.config.ts",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "migrate-create": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate dev --create-only --config libs/database/prisma.config.ts",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "migrate-deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate deploy --config libs/database/prisma.config.ts",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "migrate-status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate status --config libs/database/prisma.config.ts",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma studio --config libs/database/prisma.config.ts",
        "cwd": "{workspaceRoot}"
      },
      "cache": false,
      "continuous": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p {projectRoot}/tsconfig.lib.json",
          "tsc --noEmit -p {projectRoot}/tsconfig.spec.json"
        ],
        "parallel": false
      },
      "dependsOn": ["prisma-generate"]
    },
    "test": {
      "dependsOn": ["prisma-generate"]
    },
    "lint": {
      "dependsOn": ["prisma-generate"]
    },
    "integration": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],
      "options": {
        "command": "vitest run --config vitest.integration.config.mts",
        "cwd": "{projectRoot}"
      }
    }
  }
}

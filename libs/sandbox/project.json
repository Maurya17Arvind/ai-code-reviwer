{
  "name": "sandbox",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/sandbox/src",
  "projectType": "library",
  "tags": ["scope:node", "type:adapter"],
  "// targets": "to see all targets run: nx show project sandbox --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p {projectRoot}/tsconfig.lib.json",
          "tsc --noEmit -p {projectRoot}/tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.integration.config.mts",
        "cwd": "{projectRoot}"
      }
    }
  }
}

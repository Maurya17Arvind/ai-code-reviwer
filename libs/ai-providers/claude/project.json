{
  "name": "ai-providers-claude",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ai-providers/claude/src",
  "projectType": "library",
  "tags": ["scope:node", "type:adapter"],
  "// targets": "to see all targets run: nx show project ai-providers-claude --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p {projectRoot}/tsconfig.lib.json",
          "tsc --noEmit -p {projectRoot}/tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "live": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.live.config.mts",
        "cwd": "{projectRoot}"
      }
    }
  }
}

{
  "name": "@acra/source",
  "version": "0.0.0",
  "description": "AI Code Review Agent: multi-tenant code review platform for local Git, GitLab and GitHub.",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0",
    "pnpm": ">=10.32.0"
  },
  "scripts": {
    "postinstall": "prisma generate --config libs/database/prisma.config.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:migrate": "nx run database:migrate-deploy",
    "db:migrate:dev": "nx run database:migrate-dev",
    "db:status": "nx run database:migrate-status",
    "db:studio": "nx run database:studio",
    "dev:api": "nx serve api",
    "dev:worker": "nx serve worker",
    "dev:dashboard": "nx serve dashboard",
    "check": "nx run-many -t lint typecheck test build",
    "test:integration": "nx run-many -t integration --parallel=1",
    "format": "nx format:write",
    "format:check": "nx format:check"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.3.0",
    "@angular-devkit/schematics": "22.3.0",
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/language-service": "22.3.0",
    "@eslint/js": "10.0.1",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.11",
    "@nx/angular": "24.0.6",
    "@nx/esbuild": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/nest": "24.0.6",
    "@nx/node": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@nx/webpack": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@schematics/angular": "22.3.0",
    "@swc/helpers": "0.5.24",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/picomatch": "4.0.3",
    "@typescript-eslint/utils": "8.73.0",
    "@vitest/coverage-v8": "5.0.5",
    "angular-eslint": "22.8.0",
    "esbuild": "0.27.7",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "27.4.0",
    "nx": "24.0.6",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tslib": "2.9.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.0.5",
    "webpack": "5.110.3",
    "webpack-cli": "7.3.1",
    "webpack-dev-server": "5.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "nx",
      "@swc/core",
      "esbuild",
      "@prisma/engines",
      "prisma",
      "@parcel/watcher",
      "lmdb",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@napi-rs/wasm-runtime>@emnapi/core": "2.0.0-alpha.6",
        "@napi-rs/wasm-runtime>@emnapi/runtime": "2.0.0-alpha.6"
      }
    },
    "patchedDependencies": {
      "nx@24.0.6": "patches/nx@24.0.6.patch"
    }
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@nestjs/bullmq": "12.0.2",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.7.8",
    "commander": "15.1.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.2",
    "pg": "8.23.1",
    "picomatch": "4.0.7",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "simple-git": "4.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }

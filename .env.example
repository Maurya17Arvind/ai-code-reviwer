# ---------------------------------------------------------------------------
# AI Code Review Agent — environment template.
# Copy to `.env` for local development:   Copy-Item .env.example .env
# Never commit `.env`. Replace every `change-me` value; use long random strings
# (PowerShell: -join ((48..57)+(97..102) | Get-Random -Count 32 | % {[char]$_}) ).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Docker Compose: PostgreSQL ---------------------------------------------
POSTGRES_ADMIN_USER=acra_admin
POSTGRES_ADMIN_PASSWORD=change-me
POSTGRES_DB=acra
POSTGRES_PORT=5432
# Non-superuser role the application connects with (created on first start)
APP_DB_USER=acra_app
APP_DB_PASSWORD=change-me

# --- Docker Compose: Redis --------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# --- Application connections (must match the values above) ----------------
DATABASE_URL=postgresql://acra_app:change-me@127.0.0.1:5432/acra?schema=public
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# --- API ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3000
# Comma-separated list of allowed browser origins
API_CORS_ORIGINS=http://localhost:4300

# --- Dashboard authentication (Phase 7, ADR-035) -----------------------------
# Public dashboard URL used in invitation / password-reset links (defaults to the first CORS origin)
# DASHBOARD_PUBLIC_URL=https://review.example.com
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# Secure (HTTPS-only, __Host-) session cookie; defaults to true when NODE_ENV=production
# SESSION_COOKIE_SECURE=true
# Number of reverse proxies in front of the API (real client IP for audit logs and throttling)
TRUST_PROXY_HOPS=0
# The API also reads CREDENTIALS_MASTER_KEY, GITLAB_ALLOWED_HOSTS and WEBHOOK_PUBLIC_BASE_URL (below)
# to let admins connect GitLab projects from the dashboard; without the key that feature is off.

# --- AI reviewers (Phase 3) — used by the CLI and (Phase 4) the worker ---------
# Keys are read by the vendor SDKs; never commit them.
# ANTHROPIC_API_KEY=
ANTHROPIC_REVIEW_MODEL=claude-opus-5-5
ANTHROPIC_REVIEW_EFFORT=high
ANTHROPIC_REFUSAL_FALLBACK=true
# OPENAI_API_KEY=
# Required to enable GPT (no default is assumed):
# OPENAI_REVIEW_MODEL=
# OPENAI_REASONING_EFFORT=high
# Optional, for GPT cost estimates (USD per million tokens):
# OPENAI_PRICE_INPUT_PER_MTOK=
# OPENAI_PRICE_OUTPUT_PER_MTOK=
# OPENAI_PRICE_CACHED_INPUT_PER_MTOK=
# Local model via Ollama (free, nothing leaves the machine); used with --provider ollama|all:
# OLLAMA_REVIEW_MODEL=qwen2.5-coder:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=16384
AI_REVIEW_TIMEOUT_MS=600000

# --- GitLab integration (Phase 4) — see docs/GITLAB.md ------------------------
# Envelope-encryption master key for stored provider tokens (base64, 32 bytes):
CREDENTIALS_MASTER_KEY=change-me-generate-32-random-bytes-base64
GITLAB_ALLOWED_HOSTS=gitlab.com
GITLAB_ALLOW_PRIVATE_NETWORK=false
# Public https URL GitLab calls back (tunnel in development):
# WEBHOOK_PUBLIC_BASE_URL=https://review.example.com
# GITLAB_TOKEN is read only by the admin connect-gitlab command; set it in the shell, not here.

# --- GitHub App (Phase 5) — see docs/GITHUB.md ------------------------------
# Leave unset to run without GitHub. The worker and the admin CLI need the App id + private key;
# the API needs only the webhook secret.
# GITHUB_APP_ID=123456
# Prefer a file path (chmod 600) over an inline key; inline keys may use "\n" escapes.
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=      # random, >= 20 chars; same value as in the App settings
GITHUB_API_URL=https://api.github.com
GITHUB_ALLOWED_HOSTS=api.github.com
GITHUB_ALLOW_PRIVATE_NETWORK=false
